<local:FramelessPage
    x:Class="TranslucentTB.Xaml.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TranslucentTB.Xaml.Pages"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:TranslucentTB.Xaml.Controls"
    IsClosable="True" Width="860" Height="640">
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <muxc:NavigationView x:Name="Navigation" x:Uid="SettingsPage_Navigation" PaneDisplayMode="Left"
                             OpenPaneLength="168" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                             IsSettingsVisible="False" AlwaysShowHeader="False" SelectionChanged="NavigationChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="HomeItem" x:Uid="SettingsPage_HomeItem" Icon="Home" />
                <muxc:NavigationViewItem x:Name="AppearanceItem" x:Uid="SettingsPage_AppearanceItem" Icon="View" />
                <muxc:NavigationViewItem x:Name="ProfilesItem" x:Uid="SettingsPage_ProfilesItem" Icon="Contact" />
                <muxc:NavigationViewItem x:Name="AdaptiveItem" x:Uid="SettingsPage_AdaptiveItem" Icon="Pictures" />
                <muxc:NavigationViewItem x:Name="AutomationItem" x:Uid="SettingsPage_AutomationItem" Icon="Repair" />
                <muxc:NavigationViewItem x:Name="HotkeysItem" x:Uid="SettingsPage_HotkeysItem" Icon="Keyboard" />
            </muxc:NavigationView.MenuItems>
            <Grid>
                <ScrollViewer x:Name="HomeSection" Padding="28,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="SettingsPage_HomeHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Name="DiagnosticSummary" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button x:Name="CopyButton" x:Uid="SettingsPage_CopyButton" Click="CopyClicked" IsEnabled="False" />
                        <TextBlock x:Name="CopyStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="AppearanceSection" Visibility="Collapsed" Padding="28,24,28,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UserControl x:Name="Editor" IsEnabled="False">
                        <StackPanel Spacing="12">
                            <TextBlock x:Uid="SettingsPage_AppearanceHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                            <ComboBox x:Name="State" x:Uid="SettingsPage_State" SelectionChanged="StateChanged" MinWidth="220">
                                <ComboBoxItem x:Uid="SettingsPage_Desktop" />
                                <ComboBoxItem x:Uid="SettingsPage_Visible" />
                                <ComboBoxItem x:Uid="SettingsPage_Maximized" />
                                <ComboBoxItem x:Uid="SettingsPage_Start" />
                                <ComboBoxItem x:Uid="SettingsPage_Search" />
                                <ComboBoxItem x:Uid="SettingsPage_TaskView" />
                                <ComboBoxItem x:Uid="SettingsPage_Battery" />
                            </ComboBox>
                            <CheckBox x:Name="EnabledOption" x:Uid="SettingsPage_Enabled" Click="OptionsChanged" />
                            <TextBlock x:Name="RuleSummary" TextWrapping="Wrap" />
                            <TextBlock x:Name="BatteryHint" x:Uid="SettingsPage_BatteryHint" TextWrapping="Wrap" Visibility="Collapsed" />

                            <ComboBox x:Name="Material" x:Uid="SettingsPage_Material" SelectionChanged="MaterialChanged" MinWidth="220">
                                <ComboBoxItem x:Uid="SettingsPage_Normal" />
                                <ComboBoxItem x:Uid="SettingsPage_Opaque" />
                                <ComboBoxItem x:Uid="SettingsPage_Clear" />
                                <ComboBoxItem x:Name="BlurItem" x:Uid="SettingsPage_Blur" />
                                <ComboBoxItem x:Uid="SettingsPage_Acrylic" />
                            </ComboBox>
                            <TextBlock x:Name="BlurHint" x:Uid="SettingsPage_BlurHint" TextWrapping="Wrap" />
                            <StackPanel x:Name="ColorSection" Spacing="4">
                                <TextBlock x:Uid="SettingsPage_ColorLabel" />
                                <TextBlock x:Name="ColorHint" x:Uid="SettingsPage_ColorHint" TextWrapping="Wrap" Visibility="Collapsed" />
                                <controls:ColorPicker x:Name="Picker" x:Uid="SettingsPage_Picker" IsAlphaEnabled="True"
                                                      ColorChanged="ColorChanged" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Slider x:Name="Radius" x:Uid="SettingsPage_Radius" Minimum="0" Maximum="750"
                                    StepFrequency="0.1" ValueChanged="RadiusChanged" MaxWidth="320" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="RadiusValue" />
                            <TextBlock x:Name="RadiusHint" x:Uid="SettingsPage_RadiusHint" TextWrapping="Wrap" />
                            <CheckBox x:Name="Peek" x:Uid="SettingsPage_Peek" Click="OptionsChanged" />
                            <TextBlock x:Name="PeekHint" x:Uid="SettingsPage_PeekHint" TextWrapping="Wrap" />
                            <CheckBox x:Name="Line" x:Uid="SettingsPage_Line" Click="OptionsChanged" />
                            <TextBlock x:Name="LineHint" x:Uid="SettingsPage_LineHint" TextWrapping="Wrap" />
                            <TextBlock x:Name="PreviewHint" x:Uid="SettingsPage_PreviewHint" TextWrapping="Wrap" />
                        </StackPanel>
                        </UserControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Spacing="8" Padding="0,12,0,0">
                        <TextBlock x:Name="SavingHint" x:Uid="SettingsPage_SavingHint" Visibility="Collapsed" TextWrapping="Wrap" />
                        <TextBlock x:Name="EditStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ApplyButton" x:Uid="SettingsPage_Apply" Click="ApplyClicked" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
                            <Button x:Name="CancelButton" x:Uid="SettingsPage_Cancel" Click="CancelClicked" IsEnabled="False" />
                            <Button x:Name="ResetButton" x:Uid="SettingsPage_Reset" Click="ResetClicked" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                    <ContentDialog x:Name="ResetDialog" x:Uid="SettingsPage_ResetDialog" DefaultButton="Close" />
                </Grid>
                <ScrollViewer x:Name="ProfilesSection" Visibility="Collapsed" Padding="28,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_ProfilesHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Name="ActiveProfileText" TextWrapping="Wrap" />
                        <ListView x:Name="ProfileList" x:Uid="SettingsPage_ProfileList" SelectionMode="Single"
                                  SelectionChanged="ProfileSelectionChanged" MaxHeight="280" HorizontalAlignment="Stretch"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ActivateProfileButton" x:Uid="SettingsPage_ActivateProfile" Tag="activate" Click="ProfileButtonClicked" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
                            <Button x:Name="DuplicateProfileButton" x:Uid="SettingsPage_DuplicateProfile" Tag="duplicate" Click="ProfileButtonClicked" IsEnabled="False" />
                            <Button x:Name="ExportProfileButton" x:Uid="SettingsPage_ExportProfile" Tag="export" Click="ProfileButtonClicked" IsEnabled="False" />
                            <Button x:Name="DeleteProfileButton" x:Uid="SettingsPage_DeleteProfile" Click="DeleteProfileClicked" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Uid="SettingsPage_SaveProfileLabel" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="NewProfileName" x:Uid="SettingsPage_NewProfileName" MinWidth="260" MaxLength="64" TextChanged="NewProfileNameChanged" />
                            <Button x:Name="SaveProfileButton" x:Uid="SettingsPage_SaveProfile" Tag="save" Click="ProfileButtonClicked" IsEnabled="False" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Button x:Name="ImportProfileButton" x:Uid="SettingsPage_ImportProfile" Tag="import" Click="ProfileButtonClicked" IsEnabled="False" />
                        <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <ContentDialog x:Name="DeleteProfileDialog" x:Uid="SettingsPage_DeleteProfileDialog" DefaultButton="Close" />
                <ScrollViewer x:Name="AdaptiveSection" Visibility="Collapsed" Padding="28,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_AdaptiveHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Uid="SettingsPage_AdaptiveIntro" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="AdaptiveEnabled" x:Uid="SettingsPage_AdaptiveEnabled" Toggled="AdaptiveToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border x:Name="AdaptiveSwatch" Width="48" Height="24" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <TextBlock x:Name="AdaptiveStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox x:Name="AdaptiveSecondary" x:Uid="SettingsPage_AdaptiveSecondary" Click="AdaptiveOptionClicked" />
                        <Slider x:Name="AdaptiveIntensity" x:Uid="SettingsPage_AdaptiveIntensity" Minimum="0" Maximum="255" StepFrequency="1" MaxWidth="320" HorizontalAlignment="Left" MinWidth="280" ValueChanged="AdaptiveSliderChanged" />
                        <Slider x:Name="AdaptiveSaturation" x:Uid="SettingsPage_AdaptiveSaturation" Minimum="0" Maximum="200" StepFrequency="5" MaxWidth="320" HorizontalAlignment="Left" MinWidth="280" ValueChanged="AdaptiveSliderChanged" />
                        <Slider x:Name="AdaptiveContrast" x:Uid="SettingsPage_AdaptiveContrast" Minimum="0" Maximum="100" StepFrequency="5" MaxWidth="320" HorizontalAlignment="Left" MinWidth="280" ValueChanged="AdaptiveSliderChanged" />
                        <Button x:Name="AdaptiveExclude" x:Uid="SettingsPage_AdaptiveExclude" Click="AdaptiveExcludeClicked" />
                        <TextBlock x:Uid="SettingsPage_AdaptiveNotes" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="HotkeysSection" Visibility="Collapsed" Padding="28,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_HotkeysHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Uid="SettingsPage_HotkeysIntro" TextWrapping="Wrap" />
                        <TextBox x:Name="HotkeyOpenSettings" x:Uid="SettingsPage_HotkeyOpenSettings" MinWidth="280" HorizontalAlignment="Left" />
                        <TextBox x:Name="HotkeyToggleEffects" x:Uid="SettingsPage_HotkeyToggleEffects" MinWidth="280" HorizontalAlignment="Left" />
                        <TextBox x:Name="HotkeyNextProfile" x:Uid="SettingsPage_HotkeyNextProfile" MinWidth="280" HorizontalAlignment="Left" />
                        <TextBox x:Name="HotkeyToggleAutomation" x:Uid="SettingsPage_HotkeyToggleAutomation" MinWidth="280" HorizontalAlignment="Left" />
                        <TextBlock x:Uid="SettingsPage_HotkeysLegacy" TextWrapping="Wrap" />
                        <Button x:Name="SaveHotkeys" x:Uid="SettingsPage_SaveHotkeys" Click="SaveHotkeysClicked" Style="{ThemeResource AccentButtonStyle}" />
                        <TextBlock x:Name="HotkeysStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AutomationSection" Visibility="Collapsed" Padding="28,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="SettingsPage_AutomationHeading" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Uid="SettingsPage_AutomationIntro" TextWrapping="Wrap" />
                        <TextBlock x:Name="AutomationStatusText" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="PauseAutomation" x:Uid="SettingsPage_PauseAutomation" Toggled="PauseAutomationToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="EditRulesButton" x:Uid="SettingsPage_EditRules" Tag="edit" Click="AutomationButtonClicked" />
                            <Button x:Name="ReloadRulesButton" x:Uid="SettingsPage_ReloadRules" Tag="reload" Click="AutomationButtonClicked" />
                        </StackPanel>
                        <ListView x:Name="RulesList" x:Uid="SettingsPage_RulesList" SelectionMode="Single" SelectionChanged="RuleSelectionChanged"
                                  MaxHeight="240" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ToggleRuleButton" x:Uid="SettingsPage_ToggleRule" Tag="toggle" Click="RuleButtonClicked" IsEnabled="False" />
                            <Button x:Name="RaiseRuleButton" x:Uid="SettingsPage_RaiseRule" Tag="raise" Click="RuleButtonClicked" IsEnabled="False" />
                            <Button x:Name="LowerRuleButton" x:Uid="SettingsPage_LowerRule" Tag="lower" Click="RuleButtonClicked" IsEnabled="False" />
                            <Button x:Name="DeleteRuleButton" x:Uid="SettingsPage_DeleteRule" Tag="delete" Click="RuleButtonClicked" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Uid="SettingsPage_NewRuleHeading" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBox x:Name="RuleName" x:Uid="SettingsPage_RuleName" MaxLength="100" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" TextChanged="RuleFormChanged" />
                        <muxc:NumberBox x:Name="RulePriority" x:Uid="SettingsPage_RulePriority" Value="10" Minimum="-1000" Maximum="1000"
                                        SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200" />
                        <ComboBox x:Name="ConditionKind" x:Uid="SettingsPage_ConditionKind" SelectionChanged="ConditionKindChanged" MinWidth="320">
                            <ComboBoxItem Tag="fullscreen" x:Uid="SettingsPage_CondFullscreen" />
                            <ComboBoxItem Tag="foreground_app" x:Uid="SettingsPage_CondForeground" />
                            <ComboBoxItem Tag="app_running" x:Uid="SettingsPage_CondRunning" />
                            <ComboBoxItem Tag="foreground_maximized" x:Uid="SettingsPage_CondMaximized" />
                            <ComboBoxItem Tag="on_battery" x:Uid="SettingsPage_CondOnBattery" />
                            <ComboBoxItem Tag="battery_saver" x:Uid="SettingsPage_CondBatterySaver" />
                            <ComboBoxItem Tag="battery_below" x:Uid="SettingsPage_CondBatteryBelow" />
                            <ComboBoxItem Tag="time_range" x:Uid="SettingsPage_CondTimeRange" />
                            <ComboBoxItem Tag="weekdays" x:Uid="SettingsPage_CondWeekdays" />
                            <ComboBoxItem Tag="dark_theme" x:Uid="SettingsPage_CondDarkTheme" />
                            <ComboBoxItem Tag="monitors_at_least" x:Uid="SettingsPage_CondMonitors" />
                        </ComboBox>
                        <TextBox x:Name="ConditionValue" x:Uid="SettingsPage_ConditionValue" MaxWidth="420" MinWidth="320" HorizontalAlignment="Left" TextChanged="RuleFormChanged" />
                        <TextBlock x:Name="ConditionHint" TextWrapping="Wrap" />
                        <CheckBox x:Name="NegateCondition" x:Uid="SettingsPage_NegateCondition" />
                        <ComboBox x:Name="ActionKind" x:Uid="SettingsPage_ActionKind" SelectionChanged="ActionKindChanged" MinWidth="320">
                            <ComboBoxItem Tag="activate_profile" x:Uid="SettingsPage_ActProfile" />
                            <ComboBoxItem Tag="restore_windows" x:Uid="SettingsPage_ActRestore" />
                        </ComboBox>
                        <ComboBox x:Name="ActionProfile" x:Uid="SettingsPage_ActionProfile" MinWidth="320" />
                        <TextBlock x:Uid="SettingsPage_AdvancedRulesHint" TextWrapping="Wrap" />
                        <Button x:Name="CreateRuleButton" x:Uid="SettingsPage_CreateRule" Click="CreateRuleClicked" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
                        <TextBlock x:Name="AutomationStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</local:FramelessPage>
