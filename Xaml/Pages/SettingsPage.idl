import "Models/Primitives/TaskbarAppearance.idl";
import "Models/Primitives/TaskbarState.idl";
import "Pages/FramelessPage.idl";

namespace TranslucentTB.Xaml.Pages
{
	struct SettingsEdit
	{
		TranslucentTB.Xaml.Models.Primitives.TaskbarState State;
		UInt32 Fields;
		Int32 Accent;
		UInt32 Color;
		Boolean ShowPeek;
		Boolean ShowLine;
		Single BlurRadius;
		Boolean Enabled;
	};

	struct ProfileInfo
	{
		String Name;
		Boolean BuiltIn;
	};

	delegate void ProfileActionRequestedDelegate(String action, String name);

	struct RuleInfo
	{
		String Name;
		Boolean Enabled;
		Int32 Priority;
		String Summary;
	};

	struct NewRuleSpec
	{
		String Name;
		Int32 Priority;
		String Condition;
		String ConditionValue;
		Boolean Negate;
		String Action;
		String ActionValue;
	};

	delegate void AutomationActionRequestedDelegate(String action, Int32 index, Int32 value);
	delegate void CreateRuleRequestedDelegate(NewRuleSpec spec);
	delegate void HotkeysChangedDelegate(Windows.Foundation.Collections.IVectorView<String> bindings);
	delegate void AdaptiveColorChangedDelegate(Boolean enabled, Boolean useSecondary, Int32 intensity, Int32 saturation, Int32 contrast, Boolean excludeCurrent);
	delegate void SettingsPreviewChangedDelegate(TranslucentTB.Xaml.Models.Primitives.TaskbarAppearance appearance);
	delegate void SettingsApplyRequestedDelegate(Windows.Foundation.Collections.IVectorView<SettingsEdit> edits);

	runtimeclass SettingsPage : FramelessPage
	{
		SettingsPage();

		void SetDiagnostics(String windowsVersion, String nativeArchitecture, String processArchitecture,
			String taskbarType, String backend, UInt32 monitorCount, Boolean blurAccentState,
			Boolean xamlTaskbarService, Boolean canPeek, Boolean canShowLine);
		void SetAppearance(TranslucentTB.Xaml.Models.Primitives.TaskbarState state,
			TranslucentTB.Xaml.Models.Primitives.TaskbarAppearance saved,
			TranslucentTB.Xaml.Models.Primitives.TaskbarAppearance defaults);
		void UpdateEditor(UInt32 ruleCount, Boolean canSave, Boolean hasBattery);
		void FinishApply(Boolean saved);
		void SetProfiles(Windows.Foundation.Collections.IVectorView<ProfileInfo> profiles, String active, Boolean canSave);
		void FinishProfileAction(Boolean success, String messageKey, String detail);
		void SetAutomation(Windows.Foundation.Collections.IVectorView<RuleInfo> rules, String activeRule, String loadError, Boolean paused);
		void FinishAutomationAction(Boolean success, String messageKey, String detail);
		void SetAdaptiveColor(Boolean enabled, Boolean useSecondary, Int32 intensity, Int32 saturation, Int32 contrast, Boolean active, UInt32 color, String source, Boolean canSave);

		event SettingsPreviewChangedDelegate PreviewChanged;
		event SettingsApplyRequestedDelegate ApplyRequested;
		event ProfileActionRequestedDelegate ProfileActionRequested;
		event AutomationActionRequestedDelegate AutomationActionRequested;
		event CreateRuleRequestedDelegate CreateRuleRequested;
		event AdaptiveColorChangedDelegate AdaptiveColorChanged;
		event HotkeysChangedDelegate HotkeysChanged;
		void SetHotkeys(Windows.Foundation.Collections.IVectorView<String> bindings, String messageKey, String detail);
	}
}
